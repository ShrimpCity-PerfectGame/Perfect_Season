{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [{ "source": "/", "destination": "/page.html" }],
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "(?<sub>.*)\\.vercel\\.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
