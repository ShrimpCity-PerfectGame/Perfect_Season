{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/", "destination": "/page.html" },
    { "source": "/how-to-play", "destination": "/how-to-play.html" },
    { "source": "/how-to-play/", "destination": "/how-to-play.html" },
    { "source": "/leaderboard", "destination": "/leaderboard.html" },
    { "source": "/leaderboard/", "destination": "/leaderboard.html" },
    { "source": "/c/:code", "destination": "/page.html" },
    { "source": "/c/:code/", "destination": "/page.html" },
    { "source": "/u/:name", "destination": "/page.html" },
    { "source": "/u/:name/", "destination": "/page.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "(?<sub>.*)\\.vercel\\.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/c/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/u/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
