{
  "name": "perfect-season",
  "private": true,
  "version": "2.4.0",
  "type": "module",
  "scripts": {
    "check": "esbuild perfect-season.jsx --bundle --format=esm --platform=node --jsx=automatic --outfile=build/app.js --external:react --external:react-dom",
    "build": "node build.mjs",
    "test": "node tests/test-accounts.mjs && node tests/test-daily.mjs && node tests/test-nav.mjs",
    "test:difficulty": "node tests/test-difficulty.mjs",
    "deploy:fn:staging": "node deploy-function.mjs staging",
    "deploy:fn:prod": "node deploy-function.mjs production",
    "app:build": "node tools/app/build-app.mjs",
    "app:sync": "node tools/app/build-app.mjs && npx cap sync android",
    "app:icons": "node tools/app/icons.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/share": "^8.0.2",
    "@supabase/supabase-js": "^2.116.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@electric-sql/pglite": "^0.5.8",
    "axe-core": "^4.13.0",
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.1",
    "puppeteer-core": "^25.10.0",
    "supabase": "^2.117.0"
  }
}
